{
    "name": "maarheeze/uuid-laravel",
    "description": "laravel integration for a simple uuid value object",
    "type": "library",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Maarheeze\\Uuid\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "maarheeze/uuid": "^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "maarheeze/phpcs": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13"
    }
}
